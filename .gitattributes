# Line-ending normalization for text files.
* text=auto

# PHP-aware hunk headers in `git diff`.
*.php diff=php

# Default: nothing is included in the `composer archive` of spiral/testing.
# Re-include only the files that actually belong to the package below.
* export-ignore

# Top-level documentation and the manifest itself.
/composer.json   -export-ignore
/LICENSE         -export-ignore
/README.md       -export-ignore
/CHANGELOG.md    -export-ignore

# Agent skills shipped to consumers (composer.json `extra.skills.source`).
/skills          -export-ignore
/skills/**       -export-ignore

# Source code (`Spiral\Testing\` namespace).
/src             -export-ignore
/src/**          -export-ignore
